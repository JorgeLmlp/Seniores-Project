# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py

# Database Configuration
MYSQL_ROOT_PASSWORD=USE_UMA_SENHA_SEGURA
MYSQL_USER=root
MYSQL_PASSWORD=USE_UMA_SENHA_SEGURA
MYSQL_DATABASE=db_seniores
DATABASE_URL=mysql+pymysql://usuario:SENHA@127.0.0.1:3306/db_seniores?charset=utf8mb4

# Application
DEBUG=0
SECRET_KEY=change_me_in_production_with_a_strong_random_key
JWT_SECRET_KEY=change_me_in_production_with_a_strong_random_key
JWT_ACCESS_TOKEN_MINUTES=60


# Use DB_AUTO_SCHEMA=0 em banco remoto compartilhado para impedir DDL automatico.
DB_AUTO_SCHEMA=1
# Em Aiven defina DB_AUTO_SCHEMA=0, DATABASE_URL com mysql+pymysql:// e CA local:
# DB_SSL_CA=C:/certificados/aiven-ca.pem
# E-mail transacional: recuperar senha e entregar comunicados (OPCIONAL).
# SMTP_PORT=465 usa TLS direto; 587 usa STARTTLS.
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_USER=usuario-smtp
# SMTP_PASSWORD=senha-do-provedor
# SMTP_FROM=contato@seu-dominio.com
# Configure credenciais somente no .env local, nunca no Flutter ou GitHub.
# NUNCA coloque a senha na aplicacao Flutter ou no repositorio.
