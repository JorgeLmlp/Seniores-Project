    # Copie para .env APENAS NO SERVIDOR OU COMPUTADOR DA API.
    # Nunca publique credenciais ou certificados privados no GitHub.
    FLASK_APP=app.py
    FLASK_ENV=development
    DEBUG=0

    # Host, porta, usuário, senha codificada para URL e nome do banco Aiven.
    # NÃO copie ssl-mode=REQUIRED literalmente da URI do painel para SQLAlchemy.
    DATABASE_URL=mysql+pymysql://USUARIO:SENHA_URL_ENCODED@HOST:PORTA/NOME_DO_BANCO?charset=utf8mb4

    # Caminho absoluto do certificado CA baixado no painel Aiven.
    DB_SSL_CA=C:/certificados/ca.pem

    # SEMPRE zero no banco remoto compartilhado.
    DB_AUTO_SCHEMA=0

    # Gere duas chaves ALEATÓRIAS e DIFERENTES:
    # py -c "import secrets; print(secrets.token_hex(32))"
    SECRET_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA
    JWT_SECRET_KEY=SUBSTITUA_POR_OUTRA_CHAVE_ALEATORIA
    JWT_ACCESS_TOKEN_MINUTES=60

    # SMTP opcional para relatórios e recuperação de senha.
    # SMTP_HOST=
    # SMTP_PORT=587
    # SMTP_USER=
    # SMTP_PASSWORD=
    # SMTP_FROM=
